{
  "name": "paws-station-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev-memory.js",
    "start": "node --env-file-if-exists=.env src/cluster.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
