 "faqs": [
  {
   "q": "Do I need to pay online to book?",
   "a": "No. There is no online payment anywhere. Book your slot for free and pay at the store after the service by Cash, UPI or Card."
  },
  {
   "q": "Why might the final price differ from the estimate?",
   "a": "Prices depend on coat condition. A matted coat or extra services added on the day may change the final amount. Our groomer will always tell you before starting."
  },
  {
   "q": "Can I cancel or reschedule?",
   "a": "Yes, free of charge up to 3 hours before your slot from My Bookings."
  },
  {
   "q": "Do you groom cats?",
   "a": "Yes! Priya, our cat specialist, handles cats in a quiet, dog-free room."
  },
  {
   "q": "What vaccinations does my pet need?",
   "a": "Please make sure your pet's rabies and core vaccinations are up to date. You can mark this in the pet profile."
  }
 ]
