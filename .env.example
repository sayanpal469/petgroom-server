# ---- Required in production. The server refuses to boot if these are missing or weak. ----
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (a replica set is needed: bookings and billing use transactions)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/paws_station?retryWrites=true&w=majority
# 32 random bytes as hex. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TUNNEL_SECRET=
DATA_SECRET=
# Websites allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# How many reverse proxies sit in front of the API (1 = the Next.js site itself)
TRUST_PROXY=1

# Login OTP (Message Central) is configured in the portal: Settings > Login OTP.
# Until it is switched on, development prints OTPs in the server log.

# ---- First super admin, used by `npm run seed` ----
SEED_SUPER_ADMIN_EMAIL=owner@pawsstation.in
SEED_SUPER_ADMIN_PASSWORD=

# Optional tuning
DB_POOL_SIZE=50
WEB_CONCURRENCY=
LOG_LEVEL=info
